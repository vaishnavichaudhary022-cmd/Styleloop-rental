# ==============================================================================
# Vercel Deployment & Local Development Environment Variables
# ==============================================================================
#
# NOTE: This application is a client-side Vite + React SPA.
# It builds and runs on Vercel without requiring any mandatory secrets.
#
# If you wish to configure production domain URLs or integrate APIs,
# add the following variables in Vercel: Project Settings -> Environment Variables.

# 1. Base URL of your deployed application on Vercel
# (Vercel automatically sets VERCEL_URL at build time, but you can define a custom domain here)
VITE_APP_URL="https://your-project.vercel.app"
APP_URL="https://your-project.vercel.app"

# 2. Gemini AI API Key (Optional: for server-side / GenAI integrations)
GEMINI_API_KEY=""

# 3. Vite client-accessible API endpoint (Optional: if connecting an external backend)
# VITE_API_BASE_URL="https://api.yourdomain.com"
